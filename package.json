{
  "name": "@shidev/muster",
  "version": "0.1.0",
  "description": "Zero-config service discovery and location-transparent calls between Node.js processes: no daemon, no broker.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "node --test ./src/*.test.ts",
    "coverage": "node --test --experimental-test-coverage ./src"
  },
  "files": [
    "dist",
    "src",
    "!dist/*.test.*",
    "!src/*.test.*"
  ],
  "keywords": [
    "muster",
    "discovery",
    "registry"
  ],
  "homepage": "https://github.com/shixiongfei/muster#readme",
  "bugs": {
    "url": "https://github.com/shixiongfei/muster/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shixiongfei/muster.git"
  },
  "license": "Apache-2.0",
  "author": "shixiongfei",
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "eventlite.js": "^1.4.0",
    "jsonwebtoken": "^9.0.3",
    "msgpackr": "^2.1.3",
    "ws": "^8.22.1"
  }
}
