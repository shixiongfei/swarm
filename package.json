{
  "name": "@shidev/swarm",
  "version": "0.2.0",
  "description": "Zero-config service discovery and location-transparent calls between Node.js processes: no daemon, no broker.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "browser": {
    "./dist/multicast.js": false,
    "./dist/tcpclient.js": false,
    "./dist/tcpserver.js": false,
    "./dist/unixdiscovery.js": false,
    "./dist/wsclient.tls.js": false,
    "./dist/wsserver.js": false
  },
  "engines": {
    "node": ">=22.4"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test ./src/*.test.ts",
    "coverage": "node --test --experimental-test-coverage ./src"
  },
  "files": [
    "dist",
    "src",
    "!dist/*.test.*",
    "!src/*.test.*"
  ],
  "keywords": [
    "swarm",
    "discovery",
    "registry"
  ],
  "homepage": "https://github.com/shixiongfei/swarm#readme",
  "bugs": {
    "url": "https://github.com/shixiongfei/swarm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shixiongfei/swarm.git"
  },
  "license": "Apache-2.0",
  "author": "shixiongfei",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "eventlite.js": "^1.4.0",
    "msgpackr": "^2.1.3",
    "ws": "^8.22.1"
  }
}
